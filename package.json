{
  "name": "@facet-llc/sdk-workspace",
  "version": "0.0.0",
  "private": true,
  "description": "Facet open-source SDK and protocol packages: agents.txt parser, agent-side client, payment-rail adapters (x402, Stripe, Boson escrow), and origination verifiers (AWS AgentCore, Coinbase CDP).",
  "homepage": "https://github.com/facet-llc/sdk",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/facet-llc/sdk.git"
  },
  "bugs": {
    "url": "https://github.com/facet-llc/sdk/issues"
  },
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "lint": "prettier --check \"**/*.{ts,tsx,js,json,md,yaml,yml}\"",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md,yaml,yml}\"",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "ci": "pnpm install --frozen-lockfile && pnpm lint && pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "prettier": "^3.4.2",
    "tsup": "^8.5.1",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
