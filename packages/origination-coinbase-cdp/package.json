{
  "name": "@facet-llc/origination-coinbase-cdp",
  "version": "0.2.3",
  "private": false,
  "type": "module",
  "description": "Facet Terminal origination verifier for Coinbase Developer Platform AgentKit credentials. Verifies wallet-signed attestations from agents provisioned via CDP and emits an AgentPrincipal scoped to the agent's CDP wallet address.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/facet-llc/sdk.git",
    "directory": "packages/origination-coinbase-cdp"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist/",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "pnpm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "dependencies": {
    "@coinbase/cdp-sdk": "1.50.0",
    "@facet-llc/adapter": "workspace:*",
    "viem": "2.55.2"
  },
  "devDependencies": {
    "tsup": "^8.5.0",
    "typescript": "^5.7.2",
    "vitest": "^4.1.10"
  },
  "homepage": "https://github.com/facet-llc/sdk/tree/main/packages/origination-coinbase-cdp",
  "bugs": {
    "url": "https://github.com/facet-llc/sdk/issues"
  }
}
