{
  "name": "@facet-llc/payment-adapter-boson-escrow",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "description": "Facet Terminal payment-rail adapter for Boson Protocol x402B — escrow-backed 'secure x402B' settlement on Base. Funds are held non-custodially in the Boson escrow Diamond; Facet never takes custody. Maps Boson's commit/redeem/release escrow lifecycle onto the Facet reserve/capture/finalize contract.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/facet-llc/sdk.git",
    "directory": "packages/payment-adapter-boson-escrow"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist/",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "pnpm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "dependencies": {
    "@bosonprotocol/x402-core": "0.2.1",
    "@bosonprotocol/x402-server": "0.3.0",
    "@facet-llc/protocol": "workspace:*",
    "viem": "2.50.4"
  },
  "devDependencies": {
    "tsup": "^8.5.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "homepage": "https://github.com/facet-llc/sdk/tree/main/packages/payment-adapter-boson-escrow",
  "bugs": {
    "url": "https://github.com/facet-llc/sdk/issues"
  }
}
