{
  "name": "@facet-llc/sdk-node",
  "version": "0.1.3",
  "private": false,
  "type": "module",
  "description": "Agent-side discovery SDK for the Facet protocol (Node 20+). One-call entry point: discoverAndConnect(\"merchant.com\") fetches /.well-known/agents.txt, validates the v1.2 manifest, and returns a configured Facet Terminal client.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/facet-llc/sdk.git",
    "directory": "packages/sdk-node"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist/",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "pnpm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:smoke": "vitest run --config vitest.smoke.config.ts",
    "regenerate": "bash scripts/regenerate.sh"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "dependencies": {
    "@facet-llc/client": "workspace:*",
    "@facet-llc/protocol": "workspace:*",
    "openapi-fetch": "0.17.0"
  },
  "devDependencies": {
    "openapi-typescript": "7.13.0",
    "tsup": "^8.5.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "homepage": "https://github.com/facet-llc/sdk/tree/main/packages/sdk-node",
  "bugs": {
    "url": "https://github.com/facet-llc/sdk/issues"
  }
}
